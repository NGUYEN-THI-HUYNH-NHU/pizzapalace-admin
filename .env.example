# =============================================
# DATABASE
# =============================================
# Chuỗi kết nối MongoDB (MongoDB Atlas hoặc tự host)
DATABASE_URL="mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority"

# =============================================
# AUTHENTICATION — Clerk
# =============================================
# Lấy tại https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Đường dẫn sau khi đăng nhập / đăng xuất
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/sign-in

# =============================================
# IMAGE UPLOAD — Cloudinary
# =============================================
# Lấy tại https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# =============================================
# EMAIL — SMTP (Nodemailer)
# =============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Pizza Palace"

# =============================================
# REALTIME SERVER — Socket.IO
# =============================================
# URL công khai của realtime-server.js (dev: http://localhost:4001)
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001

# URL nội bộ mà Next.js dùng để gửi sự kiện tới realtime server
REALTIME_SERVER_URL=http://localhost:4001

# Secret dùng để xác thực request /emit
REALTIME_EMIT_SECRET=pp-realtime-dev-secret

# Port lắng nghe của realtime server (mặc định: 4001)
REALTIME_PORT=4001

# Danh sách origin được phép kết nối WebSocket (dùng * cho dev, hoặc liệt kê cách dấu phẩy)
REALTIME_ALLOWED_ORIGINS=*
